<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<Target Name="AfterBuild">
		<GenerateApi
			ApiDirectory="$(XTI_ApiDirectory)"
			ActionsDirectory="$(XTI_ApiActionsDirectory)"
			AppName="$(XTI_ApiAppName)"
			AppType="$(XTI_ApiAppType)"
			>
		</GenerateApi>
	</Target>
</Project>