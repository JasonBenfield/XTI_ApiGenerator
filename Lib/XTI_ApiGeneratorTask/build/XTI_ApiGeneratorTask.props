<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<XTI_ApiGeneratorAssembly>$(MSBuildThisFileDirectory)..\lib\netstandard2.0\$(MSBuildThisFileName).dll</XTI_ApiGeneratorAssembly>
	</PropertyGroup>

	<UsingTask TaskName="$(MSBuildThisFileName).GenerateApi" AssemblyFile="$(XTI_ApiGeneratorAssembly)"/>

	<PropertyGroup>
		<XTI_ApiDirectory Condition="'$(XTI_ApiDirectory)' == ''">[Default]</XTI_ApiDirectory>
		<XTI_ApiActionsDirectory Condition="'$(XTI_ApiActionsDirectory)' == ''">$(MSBuildProjectDirectory)</XTI_ApiActionsDirectory>
		<XTI_ApiAppName Condition="'$(XTI_ApiAppName)' == ''">[Default]</XTI_ApiAppName>
		<XTI_ApiAppType Condition="'$(XTI_ApiAppType)' == ''">[Default]</XTI_ApiAppType>
	</PropertyGroup>
</Project>